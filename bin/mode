#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

AUTO = "auto"
OFF = "off"
AXES = ("mode", "style")
BOOLEANS = ("enter-never", "no-dispatch-without-approval", "no-implement", "no-code-without-red")
FALSEY = {"false", "no", "off", "n", "0"}
FOLDER = {"mode": "modes", "style": "styles"}
STANDING = "standing reminder"
# Committed beside the code, so a repo hands every clone of it the same pair with nobody typing one.
SHARED = ".mode"
PINS = "pins.tsv"
# The pair a red-first pipeline swings on. Whichever landed last is where the lap stands.
RED, GREEN = "test-fail", "test"
# A gate hook is always on; a guard under hooks/guards/ answers to the config switch.
GATES = {"no-dispatch-without-approval": ("spawning a teammate", False),
         "no-code-without-red": ("an implementation edit", True)}
MARK = {"chosen": "~", "pinned": "="}
# A hook repeats this every turn, so each axis is capped and the pair still fits in eight lines.
STANDING_LINES = 4
# One colour per mode, so a ninth mode needed a ninth name rather than a repeated chip.
COLORS = {"red": "31", "green": "32", "yellow": "33", "blue": "34",
          "magenta": "35", "cyan": "36", "grey": "90", "sky": "94", "pink": "95"}
RESET = "\x1b[0m"
# Both are East Asian Wide: a narrow emoji here measures one column and renders two, misaligning the row.
CHIP_ICON = {"mode": "\U0001f9ed", "style": "\U0001f4ac"}
DEFAULT_USER = "the user"
USER_TOKEN = "{{USER}}"
# Silence here would leave the status-line chip naming a contract whose rules nobody can read.
UNREADABLE = ("Its contract could not be read, so the file for '%s' is missing or has no standing "
              "reminder. Say so rather than improvising what it asks for.")
GROUNDED = ("# Ground rules\n\nThese rules hold for this entire conversation. They are injected "
            "once, here, and never repeated, so keep applying them without being reminded.")


def die(msg: str, code: int = 1):
    print(msg, file=sys.stderr)
    raise SystemExit(code)


# ---------------------------------------------------------------- locations

def plugin_root() -> Path:
    override = os.environ.get("MODE_PLUGIN_ROOT")
    if override:
        return Path(override)
    # The platform sets this per hook, so it is only ours when it carries our skill.
    plugin = os.environ.get("CLAUDE_PLUGIN_ROOT", "")
    if plugin and (Path(plugin) / "skills" / "mode").is_dir():
        return Path(plugin)
    # Resolved, not raw, so the plugin folders are found through a symlinked bin/mode.
    return Path(__file__).resolve().parent.parent


def config_home() -> Path:
    return Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude")) / "mode"


def state_home() -> Path:
    """Session state sits one level down, so it can never be mistaken for a contract folder."""
    return config_home() / "state"


def contract_dirs(axis: str) -> list[Path]:
    """Shipped first, the user's own second, so a plugin update cannot delete somebody's contract."""
    return [plugin_root() / "skills" / "mode" / FOLDER[axis], config_home() / FOLDER[axis]]


def names(axis: str) -> list[str]:
    found: set[str] = set()
    for d in contract_dirs(axis):
        if d.is_dir():
            found.update(p.stem for p in d.glob("*.md"))
    return sorted(found)


def contract_file(axis: str, name: str) -> Path | None:
    for d in reversed(contract_dirs(axis)):
        p = d / f"{name}.md"
        if p.is_file():
            return p
    return None


def available(axis: str) -> str:
    found = names(axis)
    if not found:
        return f"no {FOLDER[axis]} in {' or '.join(str(d) for d in contract_dirs(axis))}"
    return f"available {FOLDER[axis]}:\n  " + "\n  ".join(found)


# -------------------------------------------------------------- state files

def session_key(sid: str | None) -> str:
    return (sid or os.environ.get("CLAUDE_CODE_SESSION_ID", ""))[:8]


def state_path(sid: str | None, suffix: str) -> Path | None:
    key = session_key(sid)
    return state_home() / f"session-{key}{suffix}" if key else None


def require(path: Path | None) -> Path:
    if not path:
        die("no session id: pass --session ID or set CLAUDE_CODE_SESSION_ID")
    return path


def read_state(path: Path | None) -> str:
    if not path or not path.is_file():
        return ""
    for line in path.read_text(errors="replace").splitlines():
        if line.strip():
            return line.strip()
    return ""


def write_state(path: Path, value: str):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(value + "\n")


def held(axis: str, sid: str | None) -> str:
    # One small file read and nothing else, because the status line calls this on every render.
    return read_state(state_path(sid, f".{axis}"))


def marked(axis: str, sid: str | None, kind: str) -> bool:
    name = held(axis, sid)
    return bool(name) and read_state(state_path(sid, f".{axis}.{kind}")) == name


def is_chosen(axis: str, sid: str | None) -> bool:
    return marked(axis, sid, "chosen")


def source_of(axis: str, sid: str | None) -> str:
    """How the slot came to hold what it holds, which is the field the chip's third column carries."""
    for kind in ("chosen", "pinned"):
        if marked(axis, sid, kind):
            return kind
    return ""


def settled(axis: str, sid: str | None) -> Path | None:
    """Set once this axis has been decided in this conversation, however it was decided.

    A pin fills only an axis nobody has spoken for yet, so `off` has to leave a trace: without one
    the next prompt would read the empty slot as untouched and pin it straight back."""
    return state_path(sid, f".{axis}.settled")


def drop_slot(axis: str, sid: str | None):
    for suffix in (f".{axis}", f".{axis}.chosen", f".{axis}.pinned", f".{axis}.announced",
                   f".{axis}.done"):
        p = state_path(sid, suffix)
        if p:
            p.unlink(missing_ok=True)
    # An approval outlives its mode only as a gate nobody meant to leave open.
    if axis == "mode":
        p = state_path(sid, ".approved")
        if p:
            p.unlink(missing_ok=True)


def stamp(name: str, value: str) -> str:
    """A record carries the mode it was made under, so one mode's record cannot satisfy another."""
    return f"{value}\t{name}"


def under(name: str, line: str) -> str:
    value, _, mode = line.partition("\t")
    return value.strip() if mode.strip() == name else ""


def approved_slug(sid: str | None, any_mode: bool = False) -> str:
    f = state_path(sid, ".approved")
    if not f or not f.is_file():
        return ""
    name = held("mode", sid)
    for line in f.read_text(errors="replace").splitlines():
        if line.strip():
            # Ignoring the stamp answers "was anything ever approved", which is a different question
            # from "may this mode dispatch" and the only way to tell the two denials apart.
            return line.partition("\t")[0].strip() if any_mode else under(name, line)
    return ""


def ledger(axis: str, sid: str | None) -> list[str]:
    """Every reason recorded under the held contract, in the order it landed.

    Order is the whole point for a pair that cancels each other out, such as a failing run and the
    pass that closes it, where the set says both happened and only the sequence says which stands."""
    f = state_path(sid, f".{axis}.done")
    if not f or not f.is_file():
        return []
    name = held(axis, sid)
    lines = f.read_text(errors="replace").splitlines()
    return [r.lower() for r in (under(name, l) for l in lines if l.strip()) if r]


def declared(axis: str, sid: str | None) -> set[str]:
    return set(ledger(axis, sid))


def red_standing(sid: str | None) -> bool:
    """A watched failure with no pass recorded after it, which is what a red-first gate opens on."""
    for reason in reversed(ledger("mode", sid)):
        if reason in (RED, GREEN):
            return reason == RED
    return False


# Observed reasons read state that already exists; every other reason waits for `done`.
OBSERVED = {"approved": lambda sid: bool(approved_slug(sid))}
# A hook injects this into a sentence a person reads, so the token itself would be machine talk.
PHRASES = {"approved": lambda sid: f"the user approved {approved_slug(sid) or 'the spec'}",
           "mr-opened": lambda sid: "the merge request is open"}


# ------------------------------------------------------------- contract text

def trim(lines: list[str]) -> str:
    while lines and not lines[0].strip():
        lines.pop(0)
    while lines and not lines[-1].strip():
        lines.pop()
    return "\n".join(lines)


def unquote(value: str) -> str:
    value = value.strip()
    if len(value) > 1 and value[0] == value[-1] and value[0] in "\"'":
        return value[1:-1]
    return value


def split_front_matter(text: str) -> tuple[dict, str]:
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        return {}, trim(lines)
    meta, end = {}, None
    for i, line in enumerate(lines[1:], 1):
        if line.strip() == "---":
            end = i
            break
        k, sep, v = line.partition(":")
        if sep:
            meta[k.strip()] = unquote(v)
    # An unterminated fence is body text that happens to open with a rule, not front matter.
    if end is None:
        return {}, trim(lines)
    return meta, trim(lines[end + 1:])


def read_contract(axis: str, name: str) -> tuple[dict, str]:
    path = contract_file(axis, name) if name and name != AUTO else None
    if not path:
        return {}, ""
    return split_front_matter(path.read_text(errors="replace"))


def meta_of(axis: str, name: str) -> dict:
    return read_contract(axis, name)[0]


def summary(axis: str, name: str) -> str:
    return meta_of(axis, name).get("summary", "")


def standing_block(text: str) -> str:
    lines = text.splitlines()
    for i, line in enumerate(lines):
        if line.startswith("## ") and line[3:].strip().lower() == STANDING:
            out = []
            for rest in lines[i + 1:]:
                if rest.startswith("## "):
                    break
                out.append(rest)
            return trim(out)
    return ""


def alternatives(meta: dict, key: str) -> list[str]:
    """A pipe-separated value, lowercased so matching ignores case on both sides."""
    return [p.strip().lower() for p in meta.get(key, "").split("|") if p.strip()]


def hits(text: str, phrases: list[str]) -> bool:
    # Leading boundary only: `build the` must miss `rebuild the`, while `fail` still catches `failures`.
    return any(re.search(r"\b" + re.escape(p), text) for p in phrases)


def truthy(meta: dict, key: str) -> bool:
    # The same rule as hooks/_shared.flag, so one contract cannot mean two things depending on which
    # layer read it. Nobody writes an opt-in restriction meaning to leave it off, so only a no is off.
    value = meta.get(key, "").strip().strip("\"'").lower()
    return bool(value) and value not in FALSEY


def never_auto(meta: dict) -> bool:
    return truthy(meta, "enter-never")


def substitute(text: str) -> str:
    # Compatibility only: a user-authored contract from before 0.8.0 may still carry the token.
    return text.replace(USER_TOKEN, DEFAULT_USER)


# --------------------------------------------------------------------- pins

def pins_file() -> Path:
    return config_home() / PINS


def read_pins() -> list[tuple[str, str, str]]:
    f = pins_file()
    if not f.is_file():
        return []
    rows = []
    for line in f.read_text(errors="replace").splitlines():
        parts = line.split("\t")
        if len(parts) == 3 and parts[0].strip():
            rows.append((parts[0], parts[1], parts[2].strip()))
    return rows


def save_pins(rows: list[tuple[str, str, str]]):
    f = pins_file()
    f.parent.mkdir(parents=True, exist_ok=True)
    f.write_text("".join("\t".join(r) + "\n" for r in sorted(set(rows))))


def where(path: str | None) -> Path:
    # A directory that no longer exists still has to answer, since a pin lookup runs on every start.
    try:
        return Path(path).resolve() if path else Path.cwd()
    except OSError:
        return Path.home()


def shared_pin(folder: Path, axis: str) -> str:
    try:
        text = (folder / SHARED).read_text(errors="replace")
    except OSError:
        return ""
    for line in text.splitlines():
        key, sep, value = line.partition(":")
        if sep and key.strip().lower() == axis:
            return unquote(value.split("#")[0]).strip()
    return ""


def pin_for(axis: str, start: Path) -> tuple[str, str, Path | None]:
    """The name pinned nearest this directory, which layer wrote it, and the folder it sat in.

    Personal beats shared in the same folder, because one is this machine's answer and the other is
    the repo's. A name no contract here answers to is stepped over rather than held, so a repo
    pinning somebody else's contract costs a stranger nothing."""
    mine = {(row[0], row[1]): row[2] for row in read_pins()}
    for folder in [start] + list(start.parents):
        for name, layer in ((mine.get((str(folder), axis), ""), "personal"),
                            (shared_pin(folder, axis), "shared")):
            if not name:
                continue
            if name == OFF:
                return "", OFF, folder
            if name != AUTO and name not in names(axis):
                continue
            return name, layer, folder
    return "", "", None


# ----------------------------------------------------------------- commands

def cmd_set(args):
    axis = args.axis
    require(state_path(args.session, f".{axis}"))
    # auto is a slot value, not a contract, so it has no file to validate against.
    if args.name not in (AUTO, OFF) and args.name not in names(axis):
        die(f"no {axis} named '{args.name}'. {available(axis)}", 2)
    # Recorded after the name is judged, so a typo is never mistaken for a decision, and before the
    # off branch returns, so emptying a slot is itself a decision that a pin has to respect.
    write_state(require(settled(axis, args.session)), args.name)
    if args.name == OFF:
        drop_slot(axis, args.session)
        print(f"{axis} set to off")
        return
    write_state(state_path(args.session, f".{axis}"), args.name)
    # Typing the name is the normal case, so an unflagged set is what leaves the slot unmarked.
    for kind in ("chosen", "pinned"):
        state_path(args.session, f".{axis}.{kind}").unlink(missing_ok=True)
    if args.chosen:
        write_state(state_path(args.session, f".{axis}.chosen"), args.name)
    print(f"{axis} set to {args.name}")


def cmd_get(args):
    axis = args.axis
    name = held(axis, args.session)
    if args.chip:
        # Always three fields: a caller splitting on tabs cannot tell a missing one from an empty one.
        color = COLORS.get(meta_of(axis, name).get("color", ""), "") if name else ""
        print(f"{name}\t{color}\t{source_of(axis, args.session)}")
        return
    if name:
        print(name)


def cmd_chips(args):
    parts = []
    for axis in AXES:
        name = held(axis, args.session)
        if name:
            label = MARK.get(source_of(axis, args.session), "") + name
            color = COLORS.get(meta_of(axis, name).get("color", ""), "")
            label = f"\x1b[{color}m{label}{RESET}" if color else label
        else:
            # An empty slot renders as off rather than vanishing, so the line always has both entries.
            label = OFF
        parts.append(f"{CHIP_ICON[axis]} {label}")
    print("  ".join(parts))


def cmd_choose(args):
    """The contract a message asks for, but only while that slot is on auto."""
    axis = args.axis
    # A value set by hand is a decision the user made, and no message overrides it.
    if held(axis, args.session) != AUTO:
        return
    text = args.message.lower()
    found = []
    for name in names(axis):
        meta = meta_of(axis, name)
        if never_auto(meta):
            continue
        if hits(text, alternatives(meta, "enter-when")):
            found.append(name)
    # Two readings of one message is a wrong reading, so choosing nothing beats guessing between them.
    if len(found) == 1:
        print(found[0])


def cmd_standing(args):
    out: list[str] = []
    for axis in AXES:
        body = read_contract(axis, held(axis, args.session))[1]
        block = standing_block(body)
        if block:
            out.extend(block.splitlines()[:STANDING_LINES])
    if out:
        print(substitute("\n".join(out)))


def cmd_axis(args):
    # So a caller can route a bare name without keeping its own copy of which contracts exist.
    for axis in AXES:
        if args.name in names(axis):
            print(axis)
            return
    raise SystemExit(1)


def cmd_version(args):
    # Reads the copy that is actually running, which is the only way to tell an update landed.
    path = plugin_root() / ".claude-plugin" / "plugin.json"
    try:
        data = json.loads(path.read_text(errors="replace"))
    except (OSError, ValueError):
        die("No readable manifest at %s, so this copy cannot say what version it is." % path)
    if not isinstance(data, dict) or not data.get("version"):
        die("%s carries no version, so an install of it would land in a directory named "
            "'unknown' and every later update would overwrite it." % path)
    print(data["version"])


def cmd_list(args):
    axes = [args.axis] if args.axis else list(AXES)
    if args.tsv:
        for axis in axes:
            current = held(axis, args.session)
            for name in names(axis):
                print(f"{axis}\t{name}\t{summary(axis, name)}\t{'active' if name == current else ''}")
        return
    first = True
    for axis in axes:
        found = names(axis)
        if not found:
            continue
        if not first:
            print()
        first = False
        print(FOLDER[axis])
        current = held(axis, args.session)
        w = max(len(n) for n in found)
        for name in found:
            print(f"{'*' if name == current else ' '} {name:<{w}}  {summary(axis, name)}".rstrip())


def show_named(args):
    """A contract read by name rather than by what is held, which is how a gate inspects one."""
    for axis in AXES:
        if args.axis in names(axis):
            meta, body = read_contract(axis, args.axis)
            text = "\n".join(f"{k}: {v}" for k, v in meta.items()) if args.meta else body
            if not text:
                die(f"no contract file for '{args.axis}' could be read", 1)
            print(text)
            return
    die(f"nothing named '{args.axis}'. {available('mode')}", 2)


def cmd_show(args):
    # A positional that is not an axis names a contract, so `show debug --meta` reads one by name.
    if args.axis and args.axis not in AXES:
        return show_named(args)
    axes = [args.axis] if args.axis else list(AXES)
    blocks, unreadable = [], []
    for axis in axes:
        name = held(axis, args.session)
        if not name or name == AUTO:
            continue
        meta, body = read_contract(axis, name)
        text = "\n".join(f"{k}: {v}" for k, v in meta.items()) if args.meta else body
        if not text:
            unreadable.append(f"{axis} holds '{name}' but no contract file for it could be read")
            continue
        # Labelled only when the caller named no axis, since two unlabelled bodies read as one.
        blocks.append(f"{axis}: {name}\n\n{text}" if not args.axis else text)
    if not blocks:
        die("\n".join(unreadable) if unreadable else f"nothing held for {' or '.join(axes)}", 1)
    print("\n\n".join(blocks))


def cmd_announce(args):
    """What a hook injects: the whole contract on the turn it is entered, the reminder after."""
    blocks = []
    for axis in AXES:
        name = held(axis, args.session)
        # auto holds no contract, so announcing it would inject the unreadable sentence forever.
        if not name or name == AUTO:
            continue
        meta, body = read_contract(axis, name)
        block = standing_block(body)
        head = f"Active {axis}: {name}"
        if not block:
            # Marking an unreadable contract announced would swallow the long version for good.
            blocks.append(f"{head}\n\n{UNREADABLE % name}")
            continue
        # Every turn, not only the first: a position restated is what keeps the pipeline from drifting.
        where = position(axis, args.session)
        tail = f"\n\n{where}" if where else ""
        marker = state_path(args.session, f".{axis}.announced")
        if marker and read_state(marker) == name:
            blocks.append(f"{head}\n\n" + "\n".join(block.splitlines()[:STANDING_LINES]) + tail)
            continue
        blocks.append(f"{head}\n\n{body}{tail}")
        if marker:
            write_state(marker, name)
    if blocks:
        print(substitute("\n\n".join(blocks)))


def rules_dirs() -> list[Path]:
    """Shipped first, the user's own second, mirroring the contract folders."""
    return [plugin_root() / "skills" / "mode" / "rules", config_home() / "rules"]


def cmd_rules(args):
    """The ground rules, whole, each injected once per conversation and exit 1 when nothing is due.
    A rule with no `when:` fires on the first prompt; one carrying a `when:` pattern waits for a
    prompt that matches it. A user file sharing a shipped stem replaces that rule, and an empty
    body silences it."""
    base_marker = state_path(args.session, ".rules")
    # No session means no way to remember they were told, and telling every turn is the one failure
    # this command exists to prevent.
    if not base_marker:
        raise SystemExit(1)
    picked: dict[str, Path] = {}
    for d in rules_dirs():
        if d.is_dir():
            for p in d.glob("*.md"):
                picked[p.stem] = p
    message = (args.message or "").lower()
    bodies = []
    base_due = not base_marker.is_file()
    told_base = False
    for stem in sorted(picked):
        meta, body = split_front_matter(picked[stem].read_text(errors="replace"))
        if not body.strip():
            continue
        when = alternatives(meta, "when")
        if when:
            marker = state_path(args.session, f".rule-{stem}")
            if marker.is_file() or not message or not hits(message, when):
                continue
            write_state(marker, "told")
            bodies.append(body.strip())
        elif base_due:
            bodies.append(body.strip())
            told_base = True
    if told_base:
        write_state(base_marker, "told")
    if not bodies:
        raise SystemExit(1)
    print(substitute(GROUNDED + "\n\n" + "\n\n".join(bodies)))


def cmd_approve(args):
    """Records the artifact the user approved, under the mode they approved it in."""
    if args.slug:
        write_state(require(state_path(args.session, ".approved")),
                    stamp(held("mode", args.session), args.slug))
        print(args.slug)
        return
    slug = approved_slug(args.session, args.any_mode)
    if not slug:
        raise SystemExit(1)
    print(slug)


def pipeline(axis: str, name: str) -> list[tuple[str, bool, str]]:
    out = []
    for token in meta_of(axis, name).get("steps", "").split(","):
        label, _, event = token.strip().partition("@")
        label = label.strip()
        if not label.rstrip("?"):
            continue
        out.append((label.rstrip("?"), label.endswith("?"), event.strip().lower()))
    return out


def arcs(axis: str, name: str, steps: list[tuple[str, bool, str]]) -> list[tuple[int, int]]:
    where = {label.lower(): i for i, (label, _, _) in enumerate(steps)}
    out = []
    for pair in meta_of(axis, name).get("loops", "").split(","):
        src, sep, dst = pair.strip().partition(">")
        if not sep:
            continue
        a, b = where.get(src.strip().lower()), where.get(dst.strip().lower())
        # A name that no longer exists drops its arc rather than the whole drawing.
        if a is not None and b is not None:
            out.append((a, b))
    return out


def furthest(axis: str, sid: str | None, steps: list[tuple[str, bool, str]]) -> int:
    """Furthest reached, not how many: a step with no event never records, so the set has holes."""
    recorded = declared(axis, sid)
    at = 0
    for i, (label, _, event) in enumerate(steps):
        if label.lower() in recorded or (event and event in recorded):
            at = i + 1
    return at


def position(axis: str, sid: str | None) -> str:
    """Where the pipeline stands, in the words a turn is told it. Empty when none is declared."""
    name = held(axis, sid)
    steps = pipeline(axis, name) if name and name != AUTO else []
    if not steps:
        return ""
    at = furthest(axis, sid, steps)
    if at >= len(steps):
        return f"Pipeline complete: all {len(steps)} steps of {name} are recorded."
    here = steps[at][0]
    behind = ", ".join(label for label, _, _ in steps[:at])
    ahead = steps[at + 1][0] if at + 1 < len(steps) else ""
    said = (f"Done: {behind}. " if behind else "") + (f"Next: {ahead}." if ahead else "")
    lines = [f"Pipeline, step {at + 1} of {len(steps)}: {here}."]
    if said.strip():
        lines.append(said.strip())
    lines.append(f"Record with `mode {axis} done {here}`, or say which step you are on.")
    return "\n".join(lines)


def cmd_step(args):
    axis, name = args.axis, held(args.axis, args.session)
    steps = pipeline(axis, name) if name and name != AUTO else []
    if not steps:
        raise SystemExit(1)
    if not args.tsv:
        print(position(axis, args.session))
        return
    at = furthest(axis, args.session, steps)
    for i, (label, gate, _) in enumerate(steps):
        print(f"step\t{label}\t{1 if gate else 0}\t{'done' if i < at else 'here' if i == at else 'next'}")
    for src, dst in arcs(axis, name, steps):
        print(f"loop\t{src}\t{dst}")


def cmd_done(args):
    """Records something the held contract waits on. Unknown reasons record too: the match decides."""
    f = require(state_path(args.session, f".{args.axis}.done"))
    f.parent.mkdir(parents=True, exist_ok=True)
    with f.open("a") as fh:
        fh.write(stamp(held(args.axis, args.session), args.reason) + "\n")
    print(f"recorded {args.reason}")


def cmd_expired(args):
    axis = args.axis
    name = held(axis, args.session)
    if not name or name == AUTO:
        raise SystemExit(1)
    done = declared(axis, args.session)
    for reason in alternatives(meta_of(axis, name), "exit-when"):
        # manual is the contract saying only the user ends it, so nothing recorded can satisfy it.
        if reason == "manual":
            continue
        observed = OBSERVED.get(reason)
        if (observed and observed(args.session)) or reason in done:
            said = PHRASES.get(reason)
            print(said(args.session) if said else reason)
            return
    raise SystemExit(1)


def cmd_exit(args):
    axis = args.axis
    name = held(axis, args.session)
    if not name or name == AUTO:
        raise SystemExit(1)
    # A chosen slot returns to auto, because a slot that emptied itself would only ever choose once.
    back = AUTO if is_chosen(axis, args.session) else OFF
    drop_slot(axis, args.session)
    if back == AUTO:
        write_state(require(state_path(args.session, f".{axis}")), AUTO)
    print(f"{axis} set to {back}")


def cmd_pin(args):
    """Writes the personal layer. With no name it answers what this directory resolves to."""
    axis, folder = args.axis, where(args.path)
    if not args.name and not args.forget:
        name, layer, _ = pin_for(axis, folder)
        if not name:
            raise SystemExit(1)
        print(name)
        return
    if args.name and args.name != OFF and args.name != AUTO and args.name not in names(axis):
        die(f"no {axis} named '{args.name}'. {available(axis)}", 2)
    rows = [r for r in read_pins() if (r[0], r[1]) != (str(folder), axis)]
    if args.forget:
        save_pins(rows)
        print(f"{axis} pin forgotten for {folder}")
        return
    # off is stored rather than deleted, since a personal no is the only way to mask a repo's own file.
    rows.append((str(folder), axis, args.name))
    save_pins(rows)
    print(f"{axis} pinned to {args.name} for {folder}")


def cmd_pins(args):
    """Where a fresh conversation started here would begin, and which file decided each slot."""
    folder = where(args.path)
    print(f"pins for {folder}")
    for axis in AXES:
        name, layer, matched = pin_for(axis, folder)
        if layer == OFF:
            print(f"  {axis:<6} {OFF:<11} pinned off at {matched}")
        elif name:
            origin = pins_file() if layer == "personal" else matched / SHARED
            print(f"  {axis:<6} {name:<11} {layer}, from {origin}")
        else:
            print(f"  {axis:<6} {'-':<11} nothing pinned at or above this directory")


def cmd_adopt(args):
    """Fills an untouched slot from the nearest pin, which is how a pin outlives a conversation.

    An axis anyone has already spoken for is never adopted into, so a pin stays a default that a
    typed name beats rather than an override that fights whoever typed it."""
    folder, filled = where(args.path), []
    for axis in AXES:
        mark = settled(axis, args.session)
        if not mark or mark.is_file() or held(axis, args.session):
            continue
        name, layer, _ = pin_for(axis, folder)
        if not name:
            continue
        write_state(state_path(args.session, f".{axis}"), name)
        write_state(state_path(args.session, f".{axis}.pinned"), name)
        write_state(mark, name)
        filled.append(f"{axis} adopted {name} from a {layer} pin")
    if not filled:
        raise SystemExit(1)
    print("\n".join(filled))


def cmd_red(args):
    """Whether a watched failure is standing, which is the one thing a red-first gate turns on."""
    if not red_standing(args.session):
        raise SystemExit(1)
    print(RED)


def cmd_clear(args):
    if args.announced:
        for axis in AXES:
            p = state_path(args.session, f".{axis}.announced")
            if p:
                p.unlink(missing_ok=True)
        # A resume or a compact drops the injected ground rules exactly as it drops a contract.
        p = state_path(args.session, ".rules")
        if p:
            p.unlink(missing_ok=True)
            for scoped in state_home().glob(f"{p.name}".replace(".rules", ".rule-") + "*"):
                scoped.unlink(missing_ok=True)
        return
    for axis in AXES:
        drop_slot(axis, args.session)
        # The settled mark goes too, so a cleared conversation is one a pin may fill again.
        p = settled(axis, args.session)
        if p:
            p.unlink(missing_ok=True)


def guards_armed() -> bool:
    """The one switch that disarms every guard under hooks/guards/, read the way those guards read it."""
    try:
        data = json.loads((config_home() / "config.json").read_text(errors="replace"))
        value = str(data.get("guards", "")).strip().strip("\"'").lower()
    except (OSError, ValueError, AttributeError):
        return True
    return not value or value not in FALSEY


def rule_state(sid: str | None) -> tuple[list[str], list[tuple[str, str]]]:
    """Which ground rules this conversation has already been told, and which are still waiting."""
    picked: dict[str, Path] = {}
    for d in rules_dirs():
        if d.is_dir():
            for p in d.glob("*.md"):
                picked[p.stem] = p
    base = state_path(sid, ".rules")
    base_told = bool(base and base.is_file())
    told, waiting = [], []
    for stem in sorted(picked):
        meta, body = split_front_matter(picked[stem].read_text(errors="replace"))
        if not body.strip():
            continue
        when = alternatives(meta, "when")
        if not when:
            (told if base_told else waiting).append((stem, ""))
            continue
        marker = state_path(sid, f".rule-{stem}")
        # Three alternatives and a count, since a scoped rule's pattern runs to a dozen phrases.
        shown = " | ".join(when[:3]) + (f" and {len(when) - 3} more" if len(when) > 3 else "")
        (told if marker and marker.is_file() else waiting).append((stem, shown))
    return [stem for stem, _ in told], waiting


def slot_lines(sid: str | None, folder: Path) -> list[str]:
    out = []
    for axis in AXES:
        name = held(axis, sid)
        if not name:
            out.append(f"  {axis:<6} {OFF:<11} nothing is asked of this axis")
            continue
        if name == AUTO:
            offered = [n for n in names(axis)
                       if not never_auto(meta_of(axis, n))
                       and alternatives(meta_of(axis, n), "enter-when")]
            out.append(f"  {axis:<6} {AUTO:<11} empty, with {len(offered)} contracts on offer to the chooser")
            continue
        source = source_of(axis, sid) or "typed"
        out.append(f"  {axis:<6} {name:<11} {source}, {summary(axis, name) or 'no summary on file'}")
        if source == "pinned":
            _, layer, matched = pin_for(axis, folder)
            origin = pins_file() if layer == "personal" else (matched / SHARED if matched else "?")
            out.append(f"  {'':<6} {'':<11} from {origin}")
    return out


def gate_lines(sid: str | None) -> list[str]:
    name = held("mode", sid)
    meta = meta_of("mode", name) if name and name != AUTO else {}
    armed = guards_armed()
    out = []
    for key, (what, switchable) in sorted(GATES.items()):
        if not truthy(meta, key):
            out.append(f"  {key:<30} open, not declared by {name or 'an empty mode slot'}")
            continue
        if switchable and not armed:
            out.append(f"  {key:<30} open, declared but disarmed by guards: off in config.json")
            continue
        if key == "no-dispatch-without-approval":
            slug = approved_slug(sid)
            said = (f"open, {slug} is approved" if slug
                    else f"SHUT, nothing is approved under {name}, so {what} is refused")
        else:
            said = ("open, a red is standing" if red_standing(sid)
                    else f"SHUT, no red is standing, so {what} is refused")
        out.append(f"  {key:<30} {said}")
    return out


def next_lines(sid: str | None) -> list[str]:
    out = []
    for axis in AXES:
        name = held(axis, sid)
        if not name or name == AUTO:
            continue
        marker = state_path(sid, f".{axis}.announced")
        if marker and read_state(marker) == name:
            block = standing_block(read_contract(axis, name)[1]).splitlines()
            out.append(f"  {axis:<6} the standing reminder of {name}, "
                       f"{min(len(block), STANDING_LINES)} lines")
        else:
            out.append(f"  {axis:<6} the whole {name} contract, once, and its reminder after that")
    return out or ["  nothing, because neither slot holds a contract"]


def cmd_why(args):
    """Everything steering this turn on one page.

    Every other surface here is either a chip too small to explain itself or text injected where
    nobody can see it, so without this the only way to know what is in force is to ask and be told."""
    sid_, folder = args.session, where(args.path)
    out = ["What is steering this conversation", "", "Slots"] + slot_lines(sid_, folder)
    place = position("mode", sid_)
    if place:
        out += ["", "Pipeline"] + ["  " + line for line in place.splitlines()]
    out += ["", "Gates"] + gate_lines(sid_)
    told, waiting = rule_state(sid_)
    out += ["", "Ground rules", "  told     " + (", ".join(told) or "none yet")]
    for stem, when in waiting:
        out.append(f"  waiting  {stem}" + (f", until a prompt matches {when}" if when else ""))
    out += ["", "The next prompt carries"] + next_lines(sid_)
    print(substitute("\n".join(out)))


def check_flags():
    """Nudges toward one spelling without refusing the file, since the readers accept it and a lint
    that rejects what runtime honours would make a contract mean two things at once."""
    for axis in AXES:
        for name in names(axis):
            meta = meta_of(axis, name)
            for key in BOOLEANS:
                value = meta.get(key, "").strip()
                if value and value not in ("true", "false"):
                    state = "on" if truthy(meta, key) else "off"
                    print(f"warning: {axis}/{name}.md has {key}: {value}. It is read as {state}, and "
                          "lowercase true or false is the spelling to keep.", file=sys.stderr)


def cmd_sync(args):
    """Rewrite the manual's registries from the folders, since front matter cannot compute itself."""
    check_flags()
    skill = plugin_root() / "skills" / "mode" / "MANUAL.md"
    if not skill.is_file():
        die(f"no manual at {skill}")
    text = skill.read_text()
    written, missing = 0, []
    for axis in AXES:
        folder, found = FOLDER[axis], names(axis)
        joined = ", ".join(found)
        # Every occurrence, since the phrase sits in the front matter description and in the body.
        text, n = re.subn(rf"({folder.capitalize()} available: )[^.]*\.",
                          lambda m: m.group(1) + joined + ".", text)
        written += n
        if not n:
            missing.append(f"{folder.capitalize()} available:")
        text, n = re.subn(rf"(?m)^{folder}:[ \t]*.*$", lambda m: f"{folder}: {joined}", text, count=1)
        written += n
        rows = [f"| `{name}` | `{folder}/{name}.md` | {summary(axis, name)} |" for name in found]
        # off and auto have no file of their own, so the folder cannot describe them and this does.
        rows.append(f"| `off` | none | Not a {axis}. `mode {axis} set off` empties the slot. |")
        rows.append(f"| `auto` | none | Not a {axis}. `mode {axis} set auto` matches each message "
                    f"against every `enter-when` and enters the winner. |")
        table = "| Name | File | Summary |\n|---|---|---|\n" + "\n".join(rows)
        text, n = re.subn(rf"(<!-- {folder}:start -->\n).*?(<!-- {folder}:end -->)",
                          lambda m: m.group(1) + table + "\n" + m.group(2), text, count=1, flags=re.S)
        written += n
        if not n:
            missing.append(f"<!-- {folder}:start --> ... <!-- {folder}:end -->")
    if not written:
        die(f"{skill} has none of the generated regions, so nothing was rewritten")
    skill.write_text(text)
    for region in missing:
        print(f"warning: no {region} region in {skill.name}", file=sys.stderr)
    write_shortcuts()


SHORTCUT = """---
description: {summary}
argument-hint: ""
disable-model-invocation: true
---

A hook read this message and set the {axis} slot to `{name}` before it reached you, so do not run
`mode {axis} set` over it. The contract is in your context above.

Confirm the switch in one line, then work the way it asks.
"""
# The ownership mark: only a file carrying this sentence is ever deleted by the stale sweep below.
SENTINEL = "A hook read this message and set the"
SHORTCUT_STEM = {"mode": "%s.md", "style": "style:%s.md"}


def user_commands_dir() -> Path:
    return Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude")) / "commands"


def write_shortcuts():
    """One command file per contract, so the palette hints the names instead of asking people to recall
    them. Generated rather than hand-written, or a new contract would ship without its shortcut."""
    # Modes stay plugin commands and arrive as /mode:<name>. Styles cannot: the plugin namespace would
    # offer them as /mode:style:<name>, so they land in the user commands folder and arrive bare.
    targets = {"mode": plugin_root() / "commands", "style": user_commands_dir()}
    for axis in AXES:
        folder = targets[axis]
        folder.mkdir(parents=True, exist_ok=True)
        keep = set()
        for name in names(axis):
            path = folder / (SHORTCUT_STEM[axis] % name)
            keep.add(path.name)
            body = SHORTCUT.format(summary=summary(axis, name) or f"Hold the {name} {axis}.",
                                   axis=axis, name=name)
            if not path.is_file() or path.read_text() != body:
                path.write_text(body)
        pattern = "style:*.md" if axis == "style" else "*.md"
        for stale in folder.glob(pattern):
            if stale.name in keep:
                continue
            try:
                # The sentinel gate: the user commands folder holds files this tool never wrote.
                if SENTINEL in stale.read_text():
                    stale.unlink()
            except OSError:
                pass


# --------------------------------------------------------------------- CLI

def main():
    common = argparse.ArgumentParser(add_help=False)
    # SUPPRESS so a --session given higher up survives the subparser's own default.
    common.add_argument("--session", metavar="ID", default=argparse.SUPPRESS,
                        help="the conversation to act on (defaults to the current one)")
    common.add_argument("--path", metavar="DIR", default=argparse.SUPPRESS,
                        help="the directory pins are resolved from (defaults to the current one)")

    ap = argparse.ArgumentParser(
        prog="mode", description="Track the mode and the style a conversation is working in.")
    ap.add_argument("--session", metavar="ID", default=None,
                    help="the conversation to act on (defaults to the current one)")
    ap.add_argument("--path", metavar="DIR", default=None,
                    help="the directory pins are resolved from (defaults to the current one)")
    sub = ap.add_subparsers(dest="cmd", required=True)

    def add(name, fn, helptext):
        p = sub.add_parser(name, parents=[common], help=helptext)
        p.set_defaults(fn=fn)
        return p

    for axis in AXES:
        other = "style" if axis == "mode" else "mode"
        ap_axis = sub.add_parser(axis, parents=[common], help=f"the {axis} slot, independent of the {other}")
        ap_axis.set_defaults(axis=axis)
        slot = ap_axis.add_subparsers(dest="slotcmd", required=True)

        def slot_add(name, fn, helptext, _slot=slot, _axis=axis):
            p = _slot.add_parser(name, parents=[common], help=helptext)
            p.set_defaults(fn=fn, axis=_axis)
            return p

        p = slot_add("set", cmd_set, "hold a contract, or auto to choose per message, or off")
        p.add_argument("name")
        p.add_argument("--chosen", action="store_true",
                       help="a pattern picked it rather than the user typing it")

        p = slot_add("get", cmd_get, "print what the slot holds")
        p.add_argument("--chip", action="store_true",
                       help="name, ANSI colour and chosen mark as three tab-separated fields")

        p = slot_add("done", cmd_done, "record something the held contract waits on, such as mr-opened")
        p.add_argument("reason")

        p = slot_add("step", cmd_step, "where the held pipeline stands, or exit 1 when it declares none")
        p.add_argument("--tsv", action="store_true",
                       help="one line per step as kind, label, gate and state, then one per loop")

        p = slot_add("pin", cmd_pin, "hold a contract for this directory in every later conversation")
        p.add_argument("name", nargs="?",
                       help="the contract to pin, off to mask a repo's own .mode, or nothing to read it back")
        p.add_argument("--forget", action="store_true",
                       help="drop the personal pin here, so a repo's own .mode shows through again")

        slot_add("expired", cmd_expired, "print why the held contract is over, or exit 1 while it stands")
        slot_add("exit", cmd_exit, "end the held contract: back to auto when chosen, off when typed")

    add("chips", cmd_chips, "one chip per axis with colour, ready to paste into a status line")

    add("pins", cmd_pins, "what a fresh conversation here would start in, and which file decided it")

    add("adopt", cmd_adopt, "fill an untouched slot from the nearest pin, or exit 1 when none applies")

    add("red", cmd_red, "print test-fail while a watched failure stands, or exit 1 once a pass closes it")

    add("why", cmd_why, "slots, pipeline, gates, ground rules and what the next prompt will carry")

    p = add("choose", cmd_choose, "the contract a message asks for, while that slot is on auto")
    p.add_argument("--axis", required=True, choices=AXES)
    p.add_argument("--message", required=True, metavar="TEXT",
                   help="the message to match against every enter-when on that axis")

    add("standing", cmd_standing, "both standing reminders, mode first")

    p = add("rules", cmd_rules, "each ground rule once per conversation, exit 1 when nothing is due")
    p.add_argument("--message", default="", metavar="TEXT",
                   help="the prompt text, matched against every scoped rule's when pattern")

    p = add("axis", cmd_axis, "which axis owns a contract name, so a bare name can be routed")
    p.add_argument("name")

    p = add("list", cmd_list, "every contract with its summary, marking the held one")
    p.add_argument("axis", nargs="?", choices=AXES)
    p.add_argument("--tsv", action="store_true", help="axis, name, summary and active per line")

    p = add("show", cmd_show, "the full contract of what is held, or of a contract named outright")
    p.add_argument("axis", nargs="?", metavar="mode|style|<name>")
    p.add_argument("--meta", action="store_true", help="the front matter instead of the body")

    add("announce", cmd_announce, "the whole contract on the turn it is entered, the reminder after")

    p = add("approve", cmd_approve, "record the artifact the user approved, or print the recorded one")
    p.add_argument("slug", nargs="?")
    p.add_argument("--any-mode", action="store_true",
                   help="read an approval whichever mode stamped it, to tell a wrong-mode deny from no yes at all")

    p = add("clear", cmd_clear, "empty both slots")
    p.add_argument("--announced", action="store_true",
                   help="drop only the announced markers, so the next announce is the long one again")

    add("sync", cmd_sync, "rewrite the skill's registries from the contract folders")

    add("version", cmd_version, "the version of the copy that is running, to check an update took")

    # A status line that exits non-zero loses the whole line, so chips never parses strictly and never fails.
    if sys.argv[1:2] == ["chips"]:
        rest = sys.argv[2:]
        at = rest.index("--session") + 1 if "--session" in rest else 0
        try:
            cmd_chips(argparse.Namespace(session=rest[at] if 0 < at < len(rest) else None))
        except Exception:
            pass
        return
    args = ap.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
